dist/
.turbo/
.cache/
.parcel-cache/
.vite/

# Python and test caches
.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS files
Thumbs.db

# Local operator checkpoints (never commit)
.checkpoints/

.operator/



all-files.txt
repo-index.txt
src-tree.txt

_codexforge-backups/

/frontend/_codexforge-backups/
_codexforge-backups/

