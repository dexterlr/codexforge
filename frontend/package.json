{
    "name": "frontend",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "predev": "npm run native:build",
        "dev": "next dev",
        "native:build": "node ./scripts/build-codexforge-creator-native.cjs",
        "native:test": "npm run native:build && node ./scripts/smoke-codexforge-creator-native-filesystem.cjs",
        "build": "npm run native:build && next build",
        "start": "next start",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "npm run typecheck",
        "check": "npm run lint && npm run typecheck",
        "clean": "rimraf .next",
        "rebuild": "npm run clean && npm run build",
        "smoke:codexforge": "powershell -ExecutionPolicy Bypass -File ./scripts/smoke-codexforge-all.ps1",
        "smoke:codexforge:server": "powershell -ExecutionPolicy Bypass -File ./scripts/smoke-codexforge-with-server.ps1",
        "smoke": "npm run smoke:codexforge",
        "validate": "npm run build && npm run smoke:codexforge:server"
    },
    "dependencies": {
        "@react-three/drei": "^10.7.7",
        "@react-three/fiber": "^9.6.1",
        "next": "16.1.6",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "three": "^0.184.0"
    },
    "devDependencies": {
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.1.6",
        "rimraf": "^5",
        "typescript": "^5"
    }
}
